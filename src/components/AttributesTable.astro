---
/**
 * Renders a consistent attribute reference table.
 *
 * Usage:
 *   <AttributesTable attributes={[
 *     { name: 'response-identifier', type: 'identifier', required: true,
 *       description: 'Links the interaction to its response variable.' },
 *     { name: 'max-choices', type: 'integer', default: '1',
 *       description: 'Maximum number of choices the candidate may select.' },
 *   ]} />
 */
interface Attribute {
	name: string;
	type?: string;
	required?: boolean;
	default?: string;
	description: string;
}

interface Props {
	attributes: Attribute[];
	caption?: string;
	/**
	 * Set on the main table of an element that inherits the shared QTI
	 * attributes (interactions and most body/content elements) to render a
	 * one-line pointer to the shared-attributes reference page instead of
	 * repeating them here.
	 */
	shared?: boolean;
}

import { withBase } from '../lib/withBase';

const { attributes, caption, shared } = Astro.props;
---

<table class="attrs">
	{caption && <caption>{caption}</caption>}
	<thead>
		<tr>
			<th>Attribute</th>
			<th>Type</th>
			<th>Required</th>
			<th>Default</th>
			<th>Description</th>
		</tr>
	</thead>
	<tbody>
		{
			attributes.map((a) => (
				<tr>
					<td>
						<code>{a.name}</code>
					</td>
					<td>{a.type ? <code>{a.type}</code> : '—'}</td>
					<td>{a.required ? 'Yes' : 'No'}</td>
					<td>{a.default ? <code>{a.default}</code> : '—'}</td>
					<td set:html={a.description} />
				</tr>
			))
		}
	</tbody>
</table>
{
	shared && (
		<p class="shared-note">
			This element also accepts the shared QTI attributes (<code>id</code>,{' '}
			<code>class</code>, <code>lang</code>, <code>label</code>, <code>dir</code>, ARIA and{' '}
			<code>data-*</code> attributes) — see{' '}
			<a href={withBase('/reference/shared-attributes/')}>Shared attributes</a>.
		</p>
	)
}

<style>
	.attrs {
		display: table;
		width: 100%;
	}
	.attrs caption {
		caption-side: top;
		text-align: left;
		font-weight: 600;
		margin-bottom: 0.4rem;
	}
	.attrs td code,
	.attrs th code {
		font-size: 0.85em;
	}
	.shared-note {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		margin-top: 0.5rem;
	}
</style>
